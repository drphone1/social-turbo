{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "Aryan_WhatsApp-Turbo_26Feb2026_1842",
    "backup1",
    "backup2_full",
    "backup3_working_with_groups",
    "backup4_debug_panel_complete",
    "temp",
    "ALL-BACKUPS",
    "Backup_Phase1_Extracted",
    "Backup_Step0_Extracted",
    "backup_phase1",
    "sessions",
    "logs",
    "work station",
    "uploads"
  ]
}
